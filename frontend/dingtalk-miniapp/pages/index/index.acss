.greeting { padding: 8px 0 16px; }
.greeting-text { font-size: 22px; font-weight: 700; color: #111; display: block; }
.greeting-sub { font-size: 13px; color: #888; margin-top: 4px; display: block; }
.notice-banner { background: linear-gradient(135deg,#e8f0ec,#d4e8df); color: #176b52; padding: 12px 16px; border-radius: 10px; font-size: 13px; margin-bottom: 18px; }
.quick-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
.action-item { width: calc(33.33% - 8px); background: #fff; border-radius: 12px; padding: 18px 10px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 6px; }
.action-icon { font-size: 28px; }
.action-label { font-size: 12px; color: #555; }
