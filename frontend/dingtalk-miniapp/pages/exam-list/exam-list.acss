.exam-list { display: flex; flex-direction: column; gap: 12px; }
.exam-card { background: #fff; border-radius: 10px; padding: 16px; }
.exam-card-title { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
.exam-card-desc { font-size: 13px; color: #888; margin-bottom: 8px; }
.exam-card-meta { font-size: 12px; color: #aaa; }
