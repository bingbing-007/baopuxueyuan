.page{padding-bottom:40rpx}
.cover{display:block;width:100%;height:420rpx;background:#e8e8e8}
.title{display:block;font-size:36rpx;font-weight:800;line-height:1.3;margin-bottom:16rpx}
.row{display:flex;align-items:center;justify-content:space-between}
.row-l{font-size:26rpx;color:var(--text2)}
.row-r{font-size:32rpx;font-weight:800;color:var(--orange)}
.row-r.free{color:var(--primary)}
.prow{display:flex;align-items:center;gap:16rpx}
.pct{font-size:32rpx;font-weight:800;color:var(--primary)}
.btns{display:flex;gap:14rpx;margin-top:24rpx}
.done-msg{margin-top:16rpx;padding:16rpx;text-align:center;background:var(--primary-light);border-radius:var(--radius)}
.done-msg text{font-size:28rpx;color:var(--primary);font-weight:700}
.chaps{display:flex;flex-direction:column;gap:10rpx}
.chap{display:flex;align-items:center;gap:14rpx;padding:18rpx 16rpx;background:#fafafa;border-radius:var(--radius-sm)}
.chap.done{background:var(--primary-lighter)}
.chap-n{width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;font-size:22rpx;font-weight:700;color:var(--text2);background:var(--card);border-radius:50%;flex-shrink:0}
.chap-info{flex:1}
.chap-t{display:block;font-size:26rpx;font-weight:600}
.chap-d{display:block;font-size:22rpx;color:var(--text3);margin-top:4rpx}
.chap-s{font-size:26rpx;flex-shrink:0}
.desc{display:block;font-size:28rpx;color:var(--text2);line-height:1.8}