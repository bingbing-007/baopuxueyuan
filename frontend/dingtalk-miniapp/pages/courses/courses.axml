<view class="page">
  <view class="search-bar" style="margin:12rpx 24rpx">
    <text class="search-bar-icon">&#9906;</text>
    <input placeholder="搜索课程、讲师…" value="{{searchText}}" onInput="onInput" confirm-type="search"/>
  </view>
  <view class="toolbar">
    <scroll-view scroll-x class="tool-cats">
      <view class="tool-inner">
        <view class="chip {{activeCat===''?'on':''}}" data-cat="" onTap="tapCat">全部</view>
        <view class="chip {{activeCat===item?'on':''}}" a:for="{{categories}}" a:key="*this" data-cat="{{item}}" onTap="tapCat">{{item}}</view>
      </view>
    </scroll-view>
    <view class="tool-sorts">
      <text class="sort {{sortBy==='dur'?'on':''}}" data-sort="dur" onTap="tapSort">时长</text>
      <text class="sort {{sortBy==='price'?'on':''}}" data-sort="price" onTap="tapSort">价格</text>
    </view>
  </view>
  <view class="cnt" a:if="{{!loading}}">共 <text style="font-weight:800;color:var(--primary)">{{filtered.length}}</text> 门课程</view>
  <view class="loading" a:if="{{loading}}">加载中…</view>
  <view class="card" a:if="{{error&&!loading}}" style="color:var(--red)">{{error}}</view>
  <view class="grid" a:if="{{!loading}}">
    <view class="gcard" a:for="{{filtered}}" a:key="id" data-id="{{item.id}}" onTap="goDetail">
      <view class="gcard-cover">
        <image class="gcard-img" src="{{item.coverUrl}}" mode="aspectFill" lazy-load/>
        <view class="gcard-badge" a:if="{{item.enrolled}}">学习中</view>
        <view class="gcard-dur">{{item.durationMinutes}}分钟</view>
      </view>
      <view class="gcard-body">
        <text class="tag" style="margin-bottom:8rpx;display:inline-flex">{{item.category}}</text>
        <text class="gcard-title">{{item.title}}</text>
        <text class="gcard-desc">{{item.description}}</text>
        <view class="gcard-foot">
          <text class="gcard-lec">{{item.lecturer}}</text>
          <text class="gcard-price" a:if="{{item.price>0}}">&yen;{{item.price}}</text>
          <text class="gcard-price free" a:else>免费</text>
        </view>
        <view class="progress" a:if="{{item.enrolled}}" style="margin-top:14rpx"><view class="progress-bar" style="width:{{item.progressPercent}}%"></view></view>
      </view>
    </view>
  </view>
  <view class="empty" a:if="{{!filtered.length&&!loading}}"><text class="empty-text">暂无课程</text></view>
  <view style="height:40rpx"></view>
</view>