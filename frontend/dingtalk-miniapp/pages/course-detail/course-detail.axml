<view class="page"><view class="loading" a:if="{{loading}}">加载中…</view><block a:if="{{course&&!loading}}">
<image class="cover" src="{{course.coverUrl}}" mode="aspectFill"/>
<view class="card" style="margin-top:0"><view style="margin-bottom:14rpx;display:flex;gap:10rpx"><text class="tag">{{course.category}}</text><text class="tag" style="color:var(--text3);background:#f5f5f5">{{course.durationMinutes}}分钟</text></view><text class="title">{{course.title}}</text><view class="row"><text class="row-l">讲师：{{course.lecturer}}</text><text class="row-r" a:if="{{course.price>0}}">&yen;{{course.price}}</text><text class="row-r free" a:else>免费</text></view></view>
<view class="card" a:if="{{course.enrolled}}"><text class="card-title">学习进度</text><view class="prow"><view class="progress" style="flex:1"><view class="progress-bar" style="width:{{course.progressPercent}}%"></view></view><text class="pct">{{course.progressPercent}}%</text></view><view class="btns"><button class="btn btn-primary" style="flex:2" onTap="startLearn">开始学习</button><button class="btn btn-outline" style="flex:1" a:if="{{course.progressPercent<100}}" data-step="25" onTap="addPct">+25%</button></view><view class="done-msg" a:if="{{course.progressPercent>=100}}"><text>已完成全部学习内容</text></view></view>
<view class="card" a:if="{{!course.enrolled}}"><button class="btn btn-primary btn-block" onTap="enroll" loading="{{enrolling}}" disabled="{{enrolling}}">立即报名</button></view>
<view class="card"><text class="card-title">课程大纲</text><view class="chaps"><view class="chap {{item.done?'done':''}}" a:for="{{chapters}}" a:key="id"><text class="chap-n">{{index+1}}</text><view class="chap-info"><text class="chap-t">{{item.title}}</text><text class="chap-d">{{item.dur}}</text></view><text class="chap-s">{{item.done?'&#10003;':'&#9906;'}}</text></view></view></view>
<view class="card"><text class="card-title">课程介绍</text><text class="desc">{{course.description}}</text></view>
<view style="height:40rpx"></view></block></view>