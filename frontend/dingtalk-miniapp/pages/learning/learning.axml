<view class="container">
  <view wx:if="{{dashboard}}" class="my-courses">
    <text class="section-title">我的课程 ({{dashboard.enrolledCount}}门)</text>
    <view wx:for="{{dashboard.courses}}" wx:key="id" class="mini-course" data-id="{{item.id}}" onTap="goDetail">
      <text class="mini-title">{{item.title}}</text>
      <progress percent="{{item.progressPercent}}" stroke-width="6" activeColor="#176b52" backgroundColor="#e5e1d8" />
    </view>
  </view>

  <view wx:if="{{paths.length}}" class="section">
    <text class="section-title">学习地图</text>
    <view wx:for="{{paths}}" wx:key="id" class="mini-course" data-id="{{item.id}}" onTap="goPath">
      <text class="mini-title">{{item.title}}</text>
    </view>
  </view>
</view>
