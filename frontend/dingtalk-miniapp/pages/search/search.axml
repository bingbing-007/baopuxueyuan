<view class="page"><view class="search-bar" style="margin:12rpx 24rpx"><text class="search-bar-icon">&#9906;</text><input placeholder="搜索课程、讲师…" value="{{text}}" onInput="onInput" confirm-type="search" onConfirm="onConfirm" focus/></view>
<view a:if="{{searching}}"><view class="cnt" a:if="{{!results.length}}">未找到相关课程</view><view a:else><view class="cnt">找到 <text style="font-weight:800;color:var(--primary)">{{results.length}}</text> 门课程</view><view class="list"><view class="scard" a:for="{{results}}" a:key="id" data-id="{{item.id}}" onTap="goDetail"><image class="scard-img" src="{{item.coverUrl}}" mode="aspectFill"/><view class="scard-body"><text class="scard-title">{{item.title}}</text><view style="display:flex;align-items:center;gap:10rpx;margin-bottom:6rpx"><text class="tag">{{item.category}}</text><text style="font-size:22rpx;color:var(--text3)">{{item.lecturer}}</text></view><text style="font-size:24rpx;font-weight:800;color:var(--orange)" a:if="{{item.price>0}}">&yen;{{item.price}}</text><text style="font-size:24rpx;font-weight:800;color:var(--primary)" a:else>免费</text></view></view></view></view></view>
<view a:if="{{!searching}}"><view class="card" a:if="{{history.length}}"><view style="display:flex;justify-content:space-between;margin-bottom:16rpx"><text class="card-title" style="margin-bottom:0">搜索历史</text><text style="font-size:24rpx;color:var(--text3)" onTap="clearHist">清空</text></view><view style="display:flex;flex-wrap:wrap;gap:12rpx"><text class="tag" style="color:var(--text2);background:#f0f0f5" a:for="{{history}}" a:key="*this" data-t="{{item}}" onTap="tapHist">{{item}}</text></view></view><view class="card"><text class="card-title">热门搜索</text><view style="display:flex;flex-wrap:wrap;gap:12rpx"><text class="tag" style="color:var(--text2);background:#f0f0f5" a:for="{{hotTags}}" a:key="*this" data-t="{{item}}" onTap="tapHot">{{item}}</text></view></view></view></view>