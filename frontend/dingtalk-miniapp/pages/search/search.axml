<view class="container">
  <view class="search-box">
    <input placeholder="搜索知识库文章…" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    <button size="mini" onTap="search">搜索</button>
  </view>

  <view wx:if="{{hotTags.length}}" class="hot-tags">
    <text class="tag-label">热门标签：</text>
    <text wx:for="{{hotTags}}" wx:key="tag" class="tag-item" data-tag="{{item.tag}}" onTap="tapTag">{{item.tag}}</text>
  </view>

  <view wx:if="{{articles.length}}" class="article-list">
    <view wx:for="{{articles}}" wx:key="id" class="article-item" data-id="{{item.id}}" onTap="goDetail">
      <text class="article-title">{{item.title}}</text>
      <text class="article-summary">{{item.summary}}</text>
      <text class="article-meta">{{item.category}} · 阅读 {{item.view_count}}</text>
    </view>
  </view>
</view>
