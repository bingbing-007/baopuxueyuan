.category-bar { display: flex; gap: 8px; padding: 12px 0; overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch; }
.cat-item { padding: 6px 16px; border-radius: 20px; font-size: 13px; background: #fff; color: #555; flex-shrink: 0; }
.cat-item.active { background: #176b52; color: #fff; }
.course-list { display: flex; flex-direction: column; gap: 12px; }
.course-card { background: #fff; border-radius: 12px; overflow: hidden; display: flex; }
.course-cover { width: 120px; height: 80px; flex-shrink: 0; }
.course-info { flex: 1; padding: 12px; display: flex; flex-direction: column; gap: 4px; }
.course-category { font-size: 11px; color: #176b52; background: #e8f0ec; padding: 2px 8px; border-radius: 10px; align-self: flex-start; }
.course-title { font-size: 15px; font-weight: 600; color: #222; }
.course-meta { font-size: 12px; color: #888; }
.course-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 2px; }
.course-price { font-size: 14px; font-weight: 700; color: #e67e22; }
.course-progress { font-size: 12px; color: #176b52; }
