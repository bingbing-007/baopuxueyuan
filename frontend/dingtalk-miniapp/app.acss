page { background: #f5f6f7; font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; font-size: 14px; color: #333; }
.container { padding: 16px; min-height: 100vh; }
.section { margin-bottom: 20px; }
.section-title { font-size: 17px; font-weight: 700; margin-bottom: 12px; color: #111; }
.loading, .empty { text-align: center; padding: 40px 16px; color: #999; font-size: 14px; }
.mini-course { background: #fff; border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; }
.mini-title { font-size: 15px; font-weight: 600; color: #222; display: block; margin-bottom: 6px; }
.mini-sub { font-size: 12px; color: #888; display: block; }
