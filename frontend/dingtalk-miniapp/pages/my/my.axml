<view class="container">
  <view wx:if="{{userInfo}}" class="my-header">
    <text class="my-name">{{userInfo.name}}</text>
    <text class="my-id">钉钉ID: {{userInfo.userId}}</text>
  </view>

  <view wx:if="{{creditAccount}}" class="credit-card">
    <text class="credit-label">我的学分</text>
    <text class="credit-balance">{{creditAccount.balance}}</text>
    <text class="credit-total">累计获得 {{creditAccount.totalEarned}}</text>
  </view>

  <view class="my-menu">
    <view class="menu-item" onTap="logout">
      <text>退出登录</text>
    </view>
  </view>
</view>
