<view class="container">
  <view class="category-bar">
    <view class="cat-item {{activeCategory===''?'active':''}}" data-cat="" onTap="filterCategory">全部</view>
    <view wx:for="{{categories}}" wx:key="*this" class="cat-item {{activeCategory===item?'active':''}}" data-cat="{{item}}" onTap="filterCategory">{{item}}</view>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:else class="course-list">
    <view wx:for="{{courses}}" wx:key="id" wx:if="{{!activeCategory || item.category===activeCategory}}" class="course-card" data-id="{{item.id}}" onTap="goDetail">
      <image class="course-cover" src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="course-info">
        <text class="course-category">{{item.category}}</text>
        <text class="course-title">{{item.title}}</text>
        <text class="course-meta">{{item.lecturer}} · {{item.durationMinutes}}分钟</text>
        <view class="course-bottom">
          <text class="course-price">{{item.price>0?'¥'+item.price:'免费'}}</text>
          <text wx:if="{{item.enrolled}}" class="course-progress">进度 {{item.progressPercent}}%</text>
        </view>
      </view>
    </view>
  </view>
</view>
