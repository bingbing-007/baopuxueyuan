.cd-hero { width: 100%; height: 200px; }
.cd-body { padding: 16px; }
.cd-category { font-size: 12px; color: #176b52; background: #e8f0ec; padding: 3px 10px; border-radius: 12px; display: inline-block; margin-bottom: 8px; }
.cd-title { font-size: 22px; font-weight: 700; color: #111; margin-bottom: 8px; }
.cd-meta { font-size: 13px; color: #888; margin-bottom: 12px; display: flex; gap: 16px; }
.cd-desc { font-size: 14px; color: #555; line-height: 1.7; margin-bottom: 20px; }
.cd-progress { background: #fff; border-radius: 10px; padding: 16px; margin-bottom: 16px; }
.cd-progress-header { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 8px; }
.cd-progress-header text:last-child { color: #176b52; font-weight: 700; }
.cd-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.cd-btn { flex: 1; padding: 14px; border-radius: 10px; font-size: 15px; font-weight: 600; text-align: center; }
.cd-btn-primary { background: #176b52; color: #fff; }
.cd-btn-outline { background: #fff; color: #176b52; border: 1px solid #176b52; }
.cd-completed { text-align: center; padding: 16px; color: #176b52; font-size: 16px; font-weight: 600; }
