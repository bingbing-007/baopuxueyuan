<view class="container">
  <view wx:if="{{userInfo}}" class="greeting">
    <text class="greeting-text">你好，{{userInfo.name}}</text>
    <text class="greeting-sub">今日学习目标待完成</text>
  </view>

  <view wx:if="{{notice}}" class="notice-banner">{{notice}}</view>

  <view class="quick-actions">
    <view wx:for="{{quickActions}}" wx:key="label" class="action-item" data-url="{{item.url}}" onTap="goAction">
      <text class="action-icon">{{item.icon}}</text>
      <text class="action-label">{{item.label}}</text>
    </view>
  </view>

  <view wx:if="{{enrolled.length}}" class="section">
    <text class="section-title">继续学习</text>
    <view wx:for="{{enrolled}}" wx:key="id" class="mini-course" data-id="{{item.id}}" onTap="goDetail">
      <text class="mini-title">{{item.title}}</text>
      <progress percent="{{item.progressPercent}}" stroke-width="6" activeColor="#176b52" backgroundColor="#e5e1d8" />
    </view>
  </view>

  <view wx:if="{{paths.length}}" class="section">
    <text class="section-title">学习地图</text>
    <view wx:for="{{paths}}" wx:key="id" class="mini-course" data-id="{{item.id}}" onTap="goPath">
      <text class="mini-title">{{item.title}}</text>
      <text class="mini-sub">{{item.category}}</text>
    </view>
  </view>

  <view wx:if="{{recommend.length}}" class="section">
    <text class="section-title">推荐课程</text>
    <view wx:for="{{recommend}}" wx:key="id" class="mini-course" data-id="{{item.id}}" onTap="goDetail">
      <text class="mini-title">{{item.title}}</text>
      <text class="mini-sub">{{item.lecturer}}</text>
    </view>
  </view>
</view>
