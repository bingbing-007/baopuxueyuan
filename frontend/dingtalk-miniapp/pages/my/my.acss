.my-header { text-align: center; padding: 24px 0; }
.my-name { font-size: 22px; font-weight: 700; display: block; }
.my-id { font-size: 13px; color: #888; margin-top: 4px; display: block; }
.credit-card { background: linear-gradient(135deg,#176b52,#2a9d6e); color: #fff; border-radius: 14px; padding: 24px; margin-bottom: 20px; text-align: center; }
.credit-label { font-size: 13px; opacity: .85; display: block; }
.credit-balance { font-size: 40px; font-weight: 800; display: block; margin: 6px 0; }
.credit-total { font-size: 12px; opacity: .75; display: block; }
.my-menu { background: #fff; border-radius: 10px; overflow: hidden; }
.menu-item { padding: 16px; border-bottom: 1px solid #f0f0f0; font-size: 15px; }
.menu-item:last-child { border-bottom: 0; }
