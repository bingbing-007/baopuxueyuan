.kw-search { display: flex; gap: 10px; align-items: center; padding: 8px 0 16px; }
.kw-search input { flex: 1; height: 38px; background: #fff; border-radius: 10px; padding: 0 12px; font-size: 14px; }
.kw-search button { padding: 0 16px; height: 38px; background: #176b52; color: #fff; border-radius: 10px; font-size: 13px; line-height: 38px; }
