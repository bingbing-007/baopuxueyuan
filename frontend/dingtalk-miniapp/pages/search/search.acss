.search-box { display: flex; gap: 10px; align-items: center; padding: 12px 0; }
.search-box input { flex: 1; height: 40px; background: #fff; border-radius: 10px; padding: 0 14px; font-size: 14px; }
.search-box button { padding: 0 18px; height: 40px; background: #176b52; color: #fff; border-radius: 10px; font-size: 14px; line-height: 40px; }
.hot-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.tag-label { font-size: 12px; color: #888; line-height: 28px; }
.tag-item { font-size: 12px; color: #176b52; background: #e8f0ec; padding: 4px 12px; border-radius: 14px; }
.article-item { background: #fff; border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; }
.article-title { font-size: 15px; font-weight: 600; color: #222; display: block; margin-bottom: 4px; }
.article-summary { font-size: 13px; color: #666; display: block; margin-bottom: 6px; }
.article-meta { font-size: 11px; color: #aaa; display: block; }
